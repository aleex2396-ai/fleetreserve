{
 "about": "Run matrix of T8's derivative check on training-site days (plan sections 7 and 13, WP9), read by fleetreserve.soft_scale_check and listed in passmarks/wp9-t8-runs.json. Equal to gate/matrix.json in every field but this text, gate_units and rotation_whatif. The gate units are caltech, office001, ASK, BAR: every second unit of truth_build.TRAIN_UNITS from the first (the other four are those of gate/t8-training-b.json). A training unit is scored only in a rotation what-if (gate_config), so rotation_whatif is true and the model is lgbm_tail_rotation, fitted on the other four training units (jpl, OSL_S, TRO, BOD). The check compares derivatives on each day's forecast bounds; it scores no forecast and reports no offer.",
 "gate_units": [
  "caltech",
  "office001",
  "ASK",
  "BAR"
 ],
 "rotation_whatif": true,
 "required_units": 2,
 "n_calibration": 100,
 "calibration_half_below": 200,
 "split_seed": 1,
 "rho": 0.0,
 "two_way_budget_kwh": 5.0,
 "audited_paths": "three fixed and five seeded vertex paths per day (audit_paths)",
 "no_fit": "cap",
 "small_fleet": "keep",
 "reference": "other-days",
 "min_cell": 20,
 "shape_tolerance": 1e-06,
 "zero_value_kwh": 1e-06,
 "t5_tolerance_kwh": 1e-06,
 "gate_rung": "one-way",
 "report": {
  "ceilings": [
   "hindsight-free-decision-hour",
   "best-causal"
  ],
  "ratio_rules": [
   "all_units",
   "all_share_passing_units",
   "required_units_both"
  ],
  "tiers": [
   "A",
   "B"
  ]
 },
